# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable the app reads is listed here. Keep it in step with src/lib/env.ts.

# Supabase: Project Settings > API Keys (or the Connect button on the project page).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Bypasses row-level security, so it is only ever read by server code.
SUPABASE_SECRET_KEY=

# A long random string, at least 16 characters. Vercel sends it with scheduled-job
# requests so nobody else can trigger them. Only needed where the scheduled job runs.
CRON_SECRET=
